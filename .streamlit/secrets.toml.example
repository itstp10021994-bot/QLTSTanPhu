# Sao chép file này thành .streamlit/secrets.toml (chạy máy) hoặc dán nội dung
# vào mục "Secrets" của Streamlit Community Cloud. KHÔNG commit secrets.toml lên GitHub.

[app]
# Email luôn có quyền quản trị (để phân quyền lần đầu)
admin_emails = ["lethienan@tanphu.edu.vn"]
school_name = "TRƯỜNG TH-THCS-THPT TÂN PHÚ"
app_title = "ỨNG DỤNG QUẢN LÝ THIẾT BỊ"
footer = "Ứng dụng được phát triển bởi trường TH, THCS và THPT Tân Phú"
timezone = "Asia/Ho_Chi_Minh"
# Giữ dữ liệu trong bộ nhớ bao nhiêu phút (app tự làm mới khi chính nó ghi; sửa trực tiếp trên SharePoint thì bấm "Làm mới")
cache_minutes = 10
# Biên bản nghiệm thu/bàn giao (tùy chọn)
# bienban_ma_so = "MH/QT-02/M04"
# bienban_hieu_luc = "14/7/2025"
# bienban_dia_diem = "Văn phòng Trường TH, THCS và THPT Tân Phú"
# Biên bản bàn giao tài sản theo phòng (tùy chọn)
# bangiao_ma_so = "HC/QT–02/M03"
# bangiao_lan_ban_hanh = "08"
# bangiao_hieu_luc = "25/11/2025"
# bangiao_dia_diem = "Trường TH, THCS và THPT Tân Phú"

# ---- CÁCH A: qua Power Automate Premium (không cần App registration) ----
# Xem docs/power_automate_bridge.md. Nếu dùng cách này thì KHÔNG cần [sharepoint] và [auth] bên dưới.
# [powerautomate]
# flow_url = "<HTTP URL của flow QLTB-API>"
# key = "<mã bí mật trùng với flow>"

# ---- CÁCH B: App registration (cần quyền Entra hoặc nhờ IT) ----
# ---- SharePoint: dán link của list thiết bị (mở list trên trình duyệt, copy thanh địa chỉ) ----
# List cá nhân (Microsoft Lists / OneDrive):
#   https://<ten>-my.sharepoint.com/personal/<email_gach_duoi>/Lists/Data_Thietbichitiet/AllItems.aspx
# List trong site nhóm:
#   https://<ten>.sharepoint.com/sites/<site>/Lists/Data_Thietbichitiet/AllItems.aspx
[sharepoint]
list_url = "https://<ten>-my.sharepoint.com/personal/<email_gach_duoi>/Lists/Data_Thietbichitiet/AllItems.aspx"
# (hoặc khai báo tách: hostname = "<ten>-my.sharepoint.com" và site_path = "/personal/<email_gach_duoi>")

# CHẾ ĐỘ 2 (chỉ khi quản trị IT cấp quyền Application): bỏ dấu # 3 dòng dưới.
# Để trống => CHẾ ĐỘ 1: đọc/ghi bằng tài khoản của chính người đang đăng nhập.
# tenant_id = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# client_id = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# client_secret = "..."

# (Tùy chọn) Tên list thật trên SharePoint nếu khác tên mặc định
# (mặc định: ThietBi = "Data_Thietbichitiet", Phong, DieuChuyen, KiemKe, PhanQuyen)
# [sharepoint.lists]
# ThietBi = "Data_Thietbichitiet"

# (Tùy chọn) Chỉ cần khi app không tự dò được cột (xem trang Khởi tạo SharePoint -> Kiểm tra)
# [sharepoint.columns.ThietBi]
# TenPhongBan = "Số serial"

# ---- Đăng nhập Microsoft 365 ----
# Bỏ mục này => chế độ demo (chọn tài khoản không cần mật khẩu). Chỉ dùng để thử!
[auth]
redirect_uri = "https://<ten-app>.streamlit.app/oauth2callback"
cookie_secret = "chuoi-ngau-nhien-dai-it-nhat-32-ky-tu"
client_id = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
client_secret = "..."
server_metadata_url = "https://login.microsoftonline.com/<tenant_id>/v2.0/.well-known/openid-configuration"
# Bắt buộc cho CHẾ ĐỘ 1: lấy token Microsoft Graph khi đăng nhập
expose_tokens = ["id", "access"]
client_kwargs = { "prompt" = "select_account", "scope" = "openid profile email offline_access https://graph.microsoft.com/Sites.ReadWrite.All" }
