# Sao chép file này thành .streamlit/secrets.toml (chạy máy) hoặc dán nội dung
# vào mục "Secrets" của Streamlit Community Cloud. KHÔNG commit secrets.toml lên GitHub.

[app]
# Email luôn có quyền quản trị (để phân quyền lần đầu)
admin_emails = ["lethienan@tanphu.edu.vn"]
school_name = "TRƯỜNG TH-THCS-THPT TÂN PHÚ"
app_title = "ỨNG DỤNG QUẢN LÝ THIẾT BỊ"
footer = "Ứng dụng được phát triển bởi trường TH, THCS và THPT Tân Phú"

# ---- Kết nối SharePoint List (Microsoft Graph, quyền ứng dụng) ----
[sharepoint]
tenant_id = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
client_id = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
client_secret = "..."
hostname = "tentruong.sharepoint.com"
site_path = "/sites/QuanLyThietBi"

# (Tùy chọn) Tên list thật trên SharePoint nếu khác tên mặc định
# [sharepoint.lists]
# ThietBi = "DS_ThietBi"
# Phong = "DS_Phong"
# DieuChuyen = "LichSuDieuChuyen"
# KiemKe = "KiemKe"
# PhanQuyen = "PhanQuyen"

# (Tùy chọn) Tên cột nội bộ (internal name) nếu list cũ dùng tên khác
# [sharepoint.columns.ThietBi]
# TenThietBi = "TenTB"
# MaPhong = "Phong"

# ---- Đăng nhập Microsoft 365 (st.login) ----
# Bỏ mục này => chế độ demo (chọn tài khoản không cần mật khẩu). Chỉ dùng để thử!
[auth]
redirect_uri = "https://<ten-app>.streamlit.app/oauth2callback"
cookie_secret = "chuoi-ngau-nhien-dai-it-nhat-32-ky-tu"
client_id = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
client_secret = "..."
server_metadata_url = "https://login.microsoftonline.com/<tenant_id>/v2.0/.well-known/openid-configuration"
client_kwargs = { "prompt" = "select_account" }
